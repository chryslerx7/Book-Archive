<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:ignore="HardcodedText,UselessParent">

    <!-- App Brand Header -->
    <TextView
        android:id="@+id/tvAppBrand"
        android:layout_width="wrap_content"

        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:text=" Book Archive "
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Title -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="16dp"
        android:text="Archive"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvAppBrand" />

    <!-- Count -->
    <TextView
        android:id="@+id/tvArchiveCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="0 books · newest on top"
        app:layout_constraintStart_toStartOf="@id/tvTitle"
        app:layout_constraintTop_toBottomOf="@id/tvTitle" />

    <!-- Scrollable Table -->
    <ScrollView
        android:id="@+id/scrollViewTable"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/btnPopLatest"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvArchiveCount">

        <TableLayout
            android:id="@+id/tableBooks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stretchColumns="*">

            <!-- Header -->
            <TableRow>
                <TextView
                    android:padding="8dp"
                    android:text="Name"
                    android:textStyle="bold" />

                <TextView
                    android:padding="8dp"
                    android:text="Author"
                    android:textStyle="bold" />

                <TextView
                    android:padding="8dp"
                    android:text="Date"
                    android:textStyle="bold" />

                <TextView
                    android:padding="8dp"
                    android:text="Category"
                    android:textStyle="bold" />
            </TableRow>
        </TableLayout>
    </ScrollView>

    <!-- Pop button -->
    <Button
        android:id="@+id/btnPopLatest"
        app:backgroundTint="#D3D3D3"
        android:textColor="#000000"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="16dp"
        android:layout_marginEnd="16dp"
        android:text="Pop latest book"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/btnHome"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Empty text -->
    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No books archived yet"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Bottom nav -->
    <!-- Home Button -->
    <Button
        android:id="@+id/btnHome"
        android:backgroundTint="#FF0000"
        android:textColor="#FFFFFF"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="Home"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnData"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Data Button -->
    <Button
        android:id="@+id/btnData"
        android:backgroundTint="#FF0000"
        android:textColor="#FFFFFF"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="Data"
        android:layout_marginStart="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/btnHome" />

</androidx.constraintlayout.widget.ConstraintLayout>
